//---MDP CONFIGS---
cfg.Enabled = true    //Configuration Enabled (Allows running)
cfg.Permission = 0    //Configuration Minimum Permission usability (0=any)
//---FUNC BELOW---

function T1(<player>) {
	
}

function T0(<player>) {
	item replace entity <player> container.0 with tacz:modern_kinetic_gun{HasBulletInBarrel:1b,GunId:"tacz:m16a4",GunCurrentAmmoCount:30,GunFireMode:"BURST",Enchantments:[{id:"minecraft:vanishing_curse",lvl:1}]}
	item replace entity <player> container.16 with tacz:ammo_box{AmmoCount:90,AmmoId:"tacz:556x45",Enchantments:[{id:"minecraft:vanishing_curse",lvl:1}]}
}

function IssueTier(<player>) {
	//if <player> has tag "Upgraded" {
	//	mdp run Gear_Default:T1 <player>
	//} else {
	//	mdp run Gear_Default:T0 <player>
	//}
	mdp run Gear_Default:T0 <player>
}

function GetGear(<player>) {
	clear <player>
	mdp run Faction_TSCLS:Combats <player>
	mdp run Gear_Normal:GetHelmet <player> 5592405
	mdp run Gear_Default:IssueTier <player>
	mdp run Gear_Normal:GetPistol <player>
	mdp run Gear_Normal:GetMelee <player>
}
